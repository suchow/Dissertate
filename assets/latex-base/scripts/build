#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

# Build the dissertation.
xelatex -interaction=nonstopmode -halt-on-error dissertation
if grep -Fq '\bibdata{' dissertation.aux; then
    bibtex dissertation
fi
xelatex -interaction=nonstopmode -halt-on-error dissertation
xelatex -interaction=nonstopmode -halt-on-error dissertation

