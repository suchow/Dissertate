\university{University of Toronto}
\universitycity{Toronto}
\universitystate{Ontario}
\definecolor{SchoolColor}{HTML}{062958}
\definecolor{chaptergrey}{HTML}{062958}
\hypersetup{colorlinks,citecolor=SchoolColor,filecolor=black,linkcolor=black,urlcolor=SchoolColor}
\RequirePackage{eso-pic}
\geometry{reset,letterpaper,left=1.25in,right=1in,top=1in,bottom=1in,footskip=0.3in}
\renewcommand{\dnormalspacing}{1.5}
\renewcommand{\dcompressedspacing}{1.0}
\renewcommand{\dissertatedocumentname}{thesis}
\renewcommand{\thefootnote}{\arabic{footnote}}
\microtypesetup{protrusion=false}
\fancypagestyle{plain}{%
    \fancyhfoffset[L]{0.25in}
    \fancyhf{}
    \fancyfoot[C]{\thepage}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{plain}
\setcitestyle{numbers,square,comma}
\patchcmd{\thebibliography}{\chapter*{\bibname}}
    {\chapter*{\bibname}\phantomsection\addcontentsline{toc}{chapter}{\bibname}}
    {}{\ClassError{Dissertate}{Cannot link the bibliography heading}{Check the bibliography definition.}}
\renewcommand{\frontmatter}{%
    \input{frontmatter/personalize}
    \hypersetup{pdftitle={\thetitle},pdfauthor={\theauthor}}
    \hypersetup{pageanchor=false}
    \maketitle
    \pagenumbering{roman}
    \hypersetup{pageanchor=true}
    \pagestyle{plain}
    \torontofrontsection{Abstract}{frontmatter/abstract}
    \torontofrontsection{Acknowledgements}{frontmatter/thanks}
    \tableofcontents
    \clearpage
    \listoffigures
    \clearpage
    \listoftables
    \clearpage
    \pagenumbering{arabic}
    \setcounter{chapter}{0}
    \setstretch{\dnormalspacing}
}
\renewcommand{\maketitle}{%
    \newgeometry{margin=1in}
    \thispagestyle{empty}
    \AddToShipoutPictureBG*{\AtPageLowerLeft{%
        \hspace*{36bp}\raisebox{1bp}{\includegraphics[width=540bp]{resources/cover.png}}}}
    \begingroup
    \centering
    \setstretch{1}
    \vspace*{195bp}
    {\fontsize{14}{32}\selectfont\thetitle\par}
    \vspace{36bp}
    by\par
    \vspace{18bp}
    \theauthor\par
    \vspace{18bp}
    Supervisor: \@advisor\par
    \@degreemonth\ \@degreeyear\par
    \endgroup
    \clearpage
    \restoregeometry
}
\newcommand{\torontofrontsection}[2]{%
    \begingroup
    \setstretch{1}
    \vspace*{\fill}
    \begin{center}#1\end{center}
    \phantomsection
    \addcontentsline{toc}{chapter}{#1}
    \input{#2}\par
    \vspace*{\fill}
    \endgroup
    \clearpage
}
\renewcommand{\backmatter}{%
    \clearpage
    \bibliographystyle{IEEEtran}
    \bibliography{references}
    \begin{appendices}
        \include{chapters/appendixA}
    \end{appendices}
    \input{endmatter/personalize}
    \clearpage
    \dissertatecolophon
    \clearpage
    \null\thispagestyle{empty}\clearpage
}
