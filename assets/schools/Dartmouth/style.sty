  Submitted to the Faculty\par
  in partial fulfillment of the requirements for the\par
  degree of\par
  Doctor of Philosophy\par
  in\par
  \@department\par
  \vspace{18pt}
  by \theauthor\par
  \vspace{18pt}
  Guarini School of Graduate and Advanced Studies\par
  Dartmouth College\par
  Hanover, New Hampshire\par
  \@degreemonth\ \@degreeyear\par
  \vspace{24pt}
  \noindent\hfill\begin{minipage}{2.4in}\raggedright
  \begin{center}Examining Committee:\end{center}
  \vspace{14pt}
  \begingroup
  \def\\{\par\vspace{20pt}\hrule\vspace{3pt}}
  \hrule\vspace{3pt}\@dartmouthcommittee\par
  \endgroup
  \end{minipage}\par
