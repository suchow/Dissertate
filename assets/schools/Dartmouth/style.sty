}
\newcommand{\dartmouthblankpage}{%
  \thispagestyle{empty}
  \iftoggle{DartmouthCopyright}{\null\vfill\begin{center}\copyright\ \@degreeyear\ \theauthor\end{center}\vfill}{\null}
  \clearpage
}
\newcommand{\abstractpage}{%
  \begin{center}ABSTRACT\end{center}
  \input{frontmatter/abstract}\clearpage
}
\newcommand{\dartmouthfrontsection}[2]{%
  \begin{center}\MakeUppercase{#1}\end{center}
  \phantomsection\addcontentsline{toc}{chapter}{#1}
  \input{#2}\clearpage
}
\renewcommand{\backmatter}{%
  \begin{appendices}\include{chapters/appendixA}\end{appendices}
  \input{endmatter/personalize}\clearpage

    \bibliographystyle{apalike2}
  \bibliography{references}\dissertatecolophon
}
