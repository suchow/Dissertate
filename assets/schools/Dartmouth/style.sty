\university{Dartmouth College}
\universitycity{Hanover}
\universitystate{New Hampshire}
\degree{Doctor of Philosophy}
\renewcommand{\dnormalspacing}{1.5}
\renewcommand{\dcompressedspacing}{1.0}
\iftoggle{DissertateSingleSpace}{\ClassWarning{Dissertate}{Guarini requires at least 18-point body line spacing; ignoring dsingle}}{}
\definecolor{SchoolColor}{HTML}{00693E}
\definecolor{chaptergrey}{HTML}{00693E}
\geometry{reset,letterpaper,left=1.5in,right=1in,top=1in,bottom=1in,footskip=0.25in}
\microtypesetup{protrusion=false}
\hypersetup{colorlinks,citecolor=SchoolColor,filecolor=black,linkcolor=black,urlcolor=SchoolColor}
\renewcommand\listfigurename{List of Illustrations}
\renewcommand\listtablename{List of Tables}
\fancypagestyle{plain}{\fancyhf{}\fancyfootoffset[L]{0.5in}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{plain}
% Ordinary lists retain the body spacing. Long quotations and footnotes may be single spaced.
\renewenvironment{itemize}{\olditemize}{\endolditemize}
\renewenvironment{enumerate}{\oldenumerate}{\endoldenumerate}
\patchcmd{\thebibliography}{\chapter*{\bibname}}{\chapter*{\bibname}\phantomsection\addcontentsline{toc}{chapter}{References}}{}{\ClassError{Dissertate}{Cannot link the bibliography heading}{Check the bibliography definition.}}
\apptocmd{\@openbib@code}{\setlength{\itemsep}{\baselineskip}\setlength{\parsep}{0pt}}{}{}
% Configure these in frontmatter/personalize.tex. The committee field accepts \\.
\def\@dartmouthcommittee{(chair) Committee Chair\\Committee Member\\Committee Member\\Committee Member}
\newcommand{\dartmouthcommittee}[1]{\gdef\@dartmouthcommittee{#1}}
% The author must verify the current dean before submission.
\def\@dartmouthdean{[Verify current dean name]}
\newcommand{\dartmouthdean}[1]{\gdef\@dartmouthdean{#1}}
\newtoggle{DartmouthCopyright}
\togglefalse{DartmouthCopyright}
\renewcommand{\frontmatter}{%
  \input{frontmatter/personalize}
  \pagenumbering{roman}
  \maketitle
  \hypersetup{pageanchor=false}
  \dartmouthblankpage
  \hypersetup{pageanchor=true}
  \setcounter{page}{2}
  \pagestyle{plain}
  \setstretch{\dnormalspacing}
  \abstractpage
  \dartmouthfrontsection{Preface and Acknowledgments}{frontmatter/thanks}
  \tableofcontents\clearpage
  \listoftables\clearpage
  \listoffigures\clearpage
  \pagenumbering{arabic}
}
