% School name and location
\university{New York University}
\universitycity{New York}
\universitystate{New York}

% School color found from university's graphic identity site:
% http://www.nyu.edu/employees/resources-and-services/media-and-communications/styleguide.html
\definecolor{SchoolColor}{HTML}{57068C} % purple
\definecolor{chaptergrey}{HTML}{57068C}

\hypersetup{
    colorlinks,
    citecolor=SchoolColor,
    filecolor=black,
    linkcolor=black,
    urlcolor=SchoolColor,
}

% NYU GSAS requirements, updated October 9, 2015:
% https://gsas.nyu.edu/content/dam/nyu-as/gsas/documents/dissertationsubmissionrelated/Doctoral%20Dissertation%20Formatting%20Requirements%2010-09-15.pdf
\geometry{reset,letterpaper,left=1in,right=1in,top=1in,bottom=1.6in,footskip=.6in}
\renewcommand{\dnormalspacing}{2.0}
\renewcommand{\dcompressedspacing}{2.0}
\renewcommand{\chapterheadendvskip}{\vspace{2\baselineskip}}
\renewcommand{\bibfont}{\normalfont\normalsize\setstretch{1.5}}
\setlength{\bibsep}{\baselineskip}
\AtBeginDocument{\setstretch{2.0}}
% These lists may also be included for a single figure or table.
% Empty lists are omitted after the auxiliary counts have settled.
\newcounter{nyufigures}
\newcounter{nyutables}
\providecommand{\nyufiguretotal}{0}
\providecommand{\nyutabletotal}{0}
\AtEndEnvironment{figure}{\stepcounter{nyufigures}}
\AtEndEnvironment{figure*}{\stepcounter{nyufigures}}
\AtEndEnvironment{table}{\stepcounter{nyutables}}
\AtEndEnvironment{table*}{\stepcounter{nyutables}}
\AtEndDocument{%
    \immediate\write\@auxout{\string\gdef\string\nyufiguretotal{\arabic{nyufigures}}}%
    \immediate\write\@auxout{\string\gdef\string\nyutabletotal{\arabic{nyutables}}}%
}

\renewcommand{\frontmatter}{
	\pagenumbering{roman}
	\input{frontmatter/personalize}
	\maketitle
	\copyrightpage
	\dedicationpage
	\acknowledgments
	\preface
	\abstractpage
	\tableofcontents

	\ifnum\nyufiguretotal>0
        \clearpage
        \phantomsection
        \addcontentsline{toc}{chapter}{List of figures}
        \listoffigures
    \fi
    \ifnum\nyutabletotal>0
        \clearpage
        \phantomsection
        \addcontentsline{toc}{chapter}{List of tables}
        \listoftables
    \fi

	% appendix listing - required only if you have two or more appendices
	% \newpage
	% \thispagestyle{empty}
	% \phantomsection
	% \addcontentsline{toc}{chapter}{List of appendices}
	% \chapter*{List of appendices}
	% \contentsline {chapter}{Appendix A}{\pageref{AppendixA}}{}

	\newpage
	\setcounter{page}{1}
	\pagenumbering{arabic}
}

\renewcommand{\maketitle}{
	\thispagestyle{empty}
	\vspace*{\fill}
	\vspace{0pt}
	\begin{center}
	\Huge \textcolor{SchoolColor}{\thetitle} \normalsize \\
	\vspace{25pt}
	by \\
	\vspace{15pt}
	\theauthor\\
	\vspace{25pt}
	\textsc{a dissertation submitted in partial fulfillment\\
	of the requirements for the degree of \\
	\vspace{8pt}
	\@degree \\
	\@department \\
	\@university \\
	\vspace{10pt}
	\@degreemonth, \@degreeyear}
    \par\vspace{\baselineskip}
    {\color{black}\rule{0.55\textwidth}{0.4pt}}\par
    \@advisor\par
    Dissertation Adviser
	\end{center}
	\vspace*{\fill}
}

\newcommand{\copyrightpage}{
	\newpage
	\thispagestyle{empty}
	\vspace*{25pt}
	\begin{center}
	\scshape \noindent \small \copyright \  \small  \theauthor \\
	all rights reserved, \@degreeyear
	\end{center}
	\newpage
	\rm
}

\newcommand{\dedicationpage}{
	\newpage
    \chapter*{Dedication}
	\phantomsection
	\addcontentsline{toc}{chapter}{Dedication}
	\vspace*{\fill}
	\scshape \noindent \input{frontmatter/dedication}
	\vspace*{\fill}
	\newpage
	\rm
}

\newcommand{\acknowledgments}{
	\chapter*{Acknowledgments}
	\phantomsection
	\addcontentsline{toc}{chapter}{Acknowledgments}
	\noindent
	\input{frontmatter/thanks}
	\vspace*{\fill} \newpage
}

\newcommand{\preface}{
	\chapter*{Preface}
	\phantomsection
	\addcontentsline{toc}{chapter}{Preface}
	\input{frontmatter/preface}
}

\newcommand{\abstractpage}{
	\chapter*{Abstract}
	\phantomsection
	\addcontentsline{toc}{chapter}{Abstract}
	\input{frontmatter/abstract}
}


\renewcommand{\backmatter}{
    \begin{appendices}
        \include{chapters/appendixA}
    \end{appendices}
    \input{endmatter/personalize}
    \dissertatecolophon
    \clearpage
    \phantomsection
    \addcontentsline{toc}{chapter}{References}
    \bibliography{references}
    \bibliographystyle{apalike2}
}
