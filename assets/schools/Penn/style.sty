  \vspace{12pt}Dissertation Committee\par\penn@committee\par\endgroup\clearpage}
\newcommand{\copyrightpage}{\thispagestyle{empty}\begingroup\centering\setstretch{2}\vspace*{\fill}\MakeUppercase{\thetitle}\par COPYRIGHT\par\@degreeyear\par\penn@legalname\par\vspace*{\fill}\endgroup\clearpage}
\newcommand{\pennfrontsection}[2]{\chapter*{#1}\phantomsection\addcontentsline{toc}{chapter}{#1}\input{#2}\clearpage}
\newcommand{\abstractpage}{\phantomsection\addcontentsline{toc}{chapter}{ABSTRACT}\begin{center}ABSTRACT\par\MakeUppercase{\thetitle}\par\theauthor\par\@advisor\par\ifdefempty{\penncosupervisor}{}{\penncosupervisor\par}\end{center}\input{frontmatter/abstract}\clearpage}
\renewcommand{\frontmatter}{\input{frontmatter/personalize}\setstretch{2}\pagenumbering{roman}\maketitle\ifpenncopyright\copyrightpage\fi\pagestyle{plain}\penndedication\pennacknowledgments\abstractpage\tableofcontents\clearpage\pennlists\pennpreface\pagenumbering{arabic}}
