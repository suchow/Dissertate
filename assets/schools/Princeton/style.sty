% School name and location
\university{Princeton University}
\universitycity{Princeton}
\universitystate{New Jersey}

% School color found from university's graphic identity site:
% http://www.princeton.edu/communications/services/image/graphic/color
\definecolor{SchoolColor}{HTML}{000000} % current submission guidance: black type
\definecolor{chaptergrey}{HTML}{000000}

\hypersetup{
    colorlinks,
    citecolor=black,
    filecolor=black,
    linkcolor=black,
    urlcolor=black,
}

% Princeton University Archives, v26.1 (April 8, 2026):
% https://libguides.princeton.edu/ld.php?content_id=77371930
% Keep the house composition; the current guide recommends black type.
\geometry{reset,letterpaper,width=5.75in,centering,top=1in,bottom=1.25in,footskip=.4in}
\AtBeginDocument{\color{black}}
\captionsetup{labelfont={bf,sf,normalsize,singlespacing},textfont={sf,normalsize,singlespacing}}
\renewcommand{\bibfont}{\normalfont\normalsize}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize{11}{13.6}}
\renewcommand{\frontmatter}{
	\input{frontmatter/personalize}
	\maketitle
	\copyrightpage
	\abstractpage
	\tableofcontents
	% \listoffigures % optional
	\dedicationpage
	\acknowledgments
}

% Preserve the official sample's case, centered groups, and text-size title.
\renewcommand{\maketitle}{%
    \thispagestyle{empty}
    \begingroup\centering\normalfont\normalsize\setstretch{1}
    \vspace*{30pt}
    \MakeUppercase{\thetitle}\par
    \vspace{84pt}
    \theauthor\par
    \vspace{36pt}
    \begingroup\setstretch{2}
    A DISSERTATION\par
    PRESENTED TO THE FACULTY\par
    OF PRINCETON UNIVERSITY\par
    IN CANDIDACY FOR THE DEGREE\par
    OF \MakeUppercase{\@degree}\par
    RECOMMENDED FOR ACCEPTANCE BY\par
    THE DEPARTMENT OF\par
    \MakeUppercase{\@department}\par
    \endgroup
    \vspace{36pt}
    Adviser: \@advisor\par
    \vspace{24pt}
    \@degreemonth\ \@degreeyear\par
    \endgroup\clearpage
}

\newcommand{\copyrightpage}{
	\newpage
	\thispagestyle{empty}
	\vspace*{25pt}
	\begin{center}
	\normalfont \noindent \normalsize \copyright \ Copyright by \theauthor, \@degreeyear. All rights reserved.
	\end{center}
	\newpage
	\rm
}

\newcommand{\abstractpage}{
    \clearpage
    \pagenumbering{arabic}
    \setcounter{page}{3}
	\phantomsection
	\addcontentsline{toc}{chapter}{Abstract}
	\pagestyle{fancy}
	\renewcommand{\headrulewidth}{0.0pt}
	\vspace*{35pt}
	\begin{center}
	\scshape Abstract \\ \rm
	\end{center}
	\input{frontmatter/abstract}
	\vspace*{\fill}
	\newpage \lhead{} \rhead{}
	\cfoot{\thepage}
}

\newcommand{\dedicationpage}{
	\newpage \thispagestyle{fancy} \vspace*{\fill}
	\scshape \noindent \input{frontmatter/dedication}
	\vspace*{\fill} \newpage \rm
}

\newcommand{\acknowledgments}{
	\chapter*{Acknowledgments}
	\noindent
	\input{frontmatter/thanks}
	\vspace*{\fill} \newpage
}

\renewcommand{\backmatter}{
    \begin{appendices}
        \include{chapters/appendixA}
    \end{appendices}
    \input{endmatter/personalize}
    \clearpage
    \phantomsection
    \addcontentsline{toc}{chapter}{References}
    \bibliography{references}
    \bibliographystyle{apalike2}
    \dissertatecolophon
}
