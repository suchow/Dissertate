% UCLA Ph.D. dissertation. April 2026 ETD Manual, including Appendix A.
% https://ucla.box.com/v/etd-filing-requirements
\university{University of California, Los Angeles}
\universitycity{Los Angeles}
\universitystate{California}
\definecolor{SchoolColor}{HTML}{000000}
\definecolor{chaptergrey}{HTML}{000000}
\geometry{reset,letterpaper,margin=1in,bottom=1.1in,footskip=0.2in}
\microtypesetup{protrusion=false}
\renewcommand{\dnormalspacing}{2.0}
\renewcommand{\dcompressedspacing}{1.0}
\setlength{\footnotesep}{2\baselineskip}
\renewcommand{\chapnumfont}{\normalfont\normalsize}
\renewcommand{\size@chapter}{\normalfont\Large}
\renewcommand*{\chapterheadstartvskip}{\vspace*{0pt}}
\setlength{\cftbeforechapskip}{0pt}
\hypersetup{colorlinks=true,linkcolor=black,citecolor=black,urlcolor=black,filecolor=black,pdflang={en-US}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\normalfont\normalsize\thepage}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{plain}
\newcommand{\uclachair}[1]{\gdef\ucla@chair{#1}}
\newcommand{\uclacommittee}[1]{\gdef\ucla@committee{#1}}
\uclachair{[CHAIR FULL NAME]}
\uclacommittee{[COMMITTEE MEMBER FULL NAME]}
% For co-chairs, replace both commands together as described in the guidance.
\newcommand{\uclaabstractchairs}{Professor \ucla@chair, Chair\par}
\newcommand{\uclacommitteechairs}{\ucla@chair, Committee Chair\par}
\newtoggle{UCLACopyrightNotice}
\toggletrue{UCLACopyrightNotice}
\newcommand{\ucladedication}{\uclafrontsection{Dedication}{frontmatter/dedication}}
\newcommand{\uclaacknowledgments}{\uclafrontsection{Acknowledgments}{frontmatter/thanks}}
\newcommand{\uclaextralists}{}
\renewcommand{\maketitle}{%
    \thispagestyle{empty}\begingroup\centering\setstretch{2}
    UNIVERSITY OF CALIFORNIA\par Los Angeles\par
    \vfill\thetitle\par
    \vfill A dissertation submitted in partial satisfaction of the\par
    requirements for the degree Doctor of Philosophy\par
    in \@department\par
    \vspace{\baselineskip}by\par
    \vspace{\baselineskip}\theauthor\par
    \vfill\@degreeyear\par\vspace*{6pt}\endgroup\clearpage}
\newcommand{\copyrightpage}{%
    \thispagestyle{empty}\null\vfill
    \iftoggle{UCLACopyrightNotice}{\begingroup\centering\setstretch{2}
    \copyright\ Copyright by\par\theauthor\par\@degreeyear\par\vspace*{6pt}\endgroup}{}
    \clearpage}
\newcommand{\abstractpage}{%
    \begingroup\centering\setstretch{2}
    ABSTRACT OF THE DISSERTATION\par
    \vspace{\baselineskip}\thetitle\par
    \vspace{\baselineskip}by\par
    \vspace{\baselineskip}\theauthor\par
    Doctor of Philosophy in \@department\par
    University of California, Los Angeles, \@degreeyear\par
    \uclaabstractchairs
    \endgroup\vspace{\baselineskip}
    \input{frontmatter/abstract}\clearpage}
\newcommand{\uclacommitteepage}{%
    \begingroup\setstretch{2}
    \noindent The dissertation of \theauthor\ is approved.\par
    \vspace{\baselineskip}\begin{center}
    \ucla@committee\par\uclacommitteechairs
    \vspace{3\baselineskip}University of California, Los Angeles\par
    \@degreeyear\par\end{center}\endgroup\clearpage}
\newcommand{\uclafrontsection}[2]{%
    \begin{center}\MakeUppercase{#1}\end{center}
    \phantomsection\addcontentsline{toc}{chapter}{#1}\input{#2}\clearpage}
\renewcommand{\frontmatter}{%
    \input{frontmatter/personalize}
    \hypersetup{pdftitle={\thetitle},pdfauthor={\theauthor},pageanchor=false}
    \setstretch{\dnormalspacing}\pagenumbering{roman}\maketitle\copyrightpage
    \setcounter{page}{2}\hypersetup{pageanchor=true}\pagestyle{plain}
    \abstractpage\uclacommitteepage\ucladedication
    \tableofcontents\clearpage\listoftables\clearpage\listoffigures\clearpage
    \uclaextralists\uclaacknowledgments
    \uclafrontsection{Vita}{resources/biography}
    \pagenumbering{arabic}}
\apptocmd{\@openbib@code}{\setlength{\itemsep}{\baselineskip}\setlength{\parsep}{0pt}}{}{\ClassError{Dissertate}{Cannot set bibliography spacing}{Check the bibliography definition.}}
\patchcmd{\thebibliography}{\chapter*{\bibname}}
    {\chapter*{\bibname}\phantomsection\addcontentsline{toc}{chapter}{\bibname}}
    {}{\ClassError{Dissertate}{Cannot link the bibliography heading}{Check the bibliography definition.}}
\renewcommand{\backmatter}{%
    \begin{appendices}\include{chapters/appendixA}\end{appendices}
    \input{endmatter/personalize}\clearpage
    \begingroup\setstretch{1}\dissertatecolophon
    \bibliographystyle{apalike2}\bibliography{references}\endgroup}

% Keep chapter epigraphs below compact headings.
\dissertateflowchapterquotes
