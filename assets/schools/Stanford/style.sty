% Stanford departmental/program Ph.D.; excludes school-specific and other degrees.
% https://studentservices.stanford.edu/my-academics/earn-my-degree/graduate-degree-progress/dissertations-and-theses/prepare-your-work-0
\university{Stanford University}
\universitycity{Stanford}
\universitystate{California}
\definecolor{SchoolColor}{HTML}{000000}
\definecolor{chaptergrey}{HTML}{000000}
\geometry{reset,letterpaper,left=1.5in,right=1in,top=1in,bottom=1.1in,footskip=0.25in}
\hypersetup{colorlinks,citecolor=black,filecolor=black,linkcolor=black,urlcolor=black}
% TeX Live's cm-unicode package supplies these OpenType Computer Modern fonts.
\setmainfont[BoldFont=cmunbx.otf,ItalicFont=cmunti.otf,BoldItalicFont=cmunbi.otf]{cmunrm.otf}
\setsansfont[BoldFont=cmunbx.otf,ItalicFont=cmunti.otf,BoldItalicFont=cmunbi.otf]{cmunrm.otf}
\setmonofont[BoldFont=cmuntb.otf,ItalicFont=cmunit.otf,BoldItalicFont=cmuntx.otf]{cmuntt.otf}
\renewfontfamily{\smallcaps}[Letters=SmallCaps]{cmunrm.otf}
\setmathsfont(Digits,Latin,Greek)[ItalicFont=cmunti.otf,BoldFont=cmunbx.otf,BoldItalicFont=cmunbi.otf]{cmunrm.otf}
\setmathrm[ItalicFont=cmunti.otf,BoldFont=cmunbx.otf,BoldItalicFont=cmunbi.otf]{cmunrm.otf}
\renewcommand{\chapnumfont}{\normalfont\normalsize}
\renewcommand*{\chapterheadstartvskip}{\vspace*{0pt}}
\microtypesetup{protrusion=false}
\iftoggle{DissertateSingleSpace}{\ClassWarning{Dissertate}{Stanford requires at least one-and-a-half-spaced main text; ignoring dsingle.}}{}
\renewcommand{\dnormalspacing}{2.0}
\renewcommand{\dcompressedspacing}{1.0}
\renewenvironment{itemize}{\begin{spacing}{\dnormalspacing}\olditemize}{\endolditemize\end{spacing}}
\renewenvironment{enumerate}{\begin{spacing}{\dnormalspacing}\oldenumerate}{\endoldenumerate\end{spacing}}
\setlength{\cftbeforechapskip}{0pt}
\fancypagestyle{plain}{%
    \fancyhf{}\fancyfoot[C]{\normalfont\normalsize\thepage}
    \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{plain}
\newcommand{\stanfordunitprefix}[1]{\gdef\stanford@unitprefix{#1}}
\stanfordunitprefix{DEPARTMENT OF}
\patchcmd{\thebibliography}{\chapter*{\bibname}}
    {\chapter*{\bibname}\phantomsection\addcontentsline{toc}{chapter}{\bibname}}
    {}{\ClassError{Dissertate}{Cannot link the bibliography heading}{Check the bibliography definition.}}
\renewcommand{\frontmatter}{%
    \input{frontmatter/personalize}
    \pagenumbering{roman}
    \maketitle
    % Axess inserts pages ii and iii; neither is present in the upload PDF.
    \setcounter{page}{4}
    \setstretch{\dnormalspacing}
    \pagestyle{plain}
    \stanfordfrontsection{Abstract}{frontmatter/abstract}
    \stanfordfrontsection{Acknowledgments}{frontmatter/thanks}
    \stanfordfrontsection{Dedication}{frontmatter/dedication}
    \tableofcontents\clearpage
    \listoftables\clearpage
    \listoffigures\clearpage
    \pagenumbering{arabic}}
\renewcommand{\maketitle}{%
    \thispagestyle{empty}
    \begingroup\centering\normalfont\normalsize\setstretch{1}
    \vspace*{0pt}
    \MakeUppercase{\thetitle}\par
    \vspace{3\baselineskip}
    \setstretch{1.8}
    A DISSERTATION\par
    SUBMITTED TO THE \MakeUppercase{\stanford@unitprefix}\par
    \MakeUppercase{\@department}\par
    AND THE COMMITTEE ON GRADUATE STUDIES\par
    OF STANFORD UNIVERSITY\par
    IN PARTIAL FULFILLMENT OF THE REQUIREMENTS\par
    FOR THE DEGREE OF\par
    DOCTOR OF PHILOSOPHY\par
    \vspace{180pt}
    \setstretch{1}
    \MakeUppercase{\theauthor}\par
    \vspace{2\baselineskip}
    \MakeUppercase{\@degreemonth\ \@degreeyear}\par
    \vspace*{\fill}
    \endgroup\clearpage}
\newcommand{\stanfordfrontsection}[2]{%
    \chapter*{#1}\phantomsection\addcontentsline{toc}{chapter}{#1}
    \input{#2}\clearpage}
\renewcommand{\backmatter}{%
    \begin{appendices}\include{chapters/appendixA}\end{appendices}
    \input{endmatter/personalize}\clearpage
    \begingroup\setstretch{1}
    \dissertatecolophon
    \bibliographystyle{apalike2}\bibliography{references}
    \endgroup}

\renewcommand{\dissertatebodyfont}{Computer Modern Unicode}

% Keep chapter epigraphs below compact headings.
\dissertateflowchapterquotes
