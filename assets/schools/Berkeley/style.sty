% School name and location
\university{University of California, Berkeley}
\universitycity{Berkeley}
\universitystate{California}

% https://brand.berkeley.edu/visual-identity/colors/
\definecolor{SchoolColor}{HTML}{002676} % Berkeley Blue
\definecolor{chaptergrey}{HTML}{002676}

\hypersetup{
    colorlinks,
    citecolor=black,
    filecolor=black,
    linkcolor=black,
    urlcolor=black,
}

% Berkeley requirements, including the April 2026 revision:
% https://grad.berkeley.edu/academics/degree-progress/dissertation/
\geometry{reset,letterpaper,width=5.75in,centering,top=1in,bottom=1.25in,footskip=.4in}
\renewcommand{\dnormalspacing}{1.0}
\renewcommand{\dcompressedspacing}{1.0}
\renewcommand{\bibfont}{\normalfont\normalsize}
\setlength{\bibsep}{0pt}
\AtBeginDocument{\setstretch{1.0}\color{black}\microtypesetup{protrusion=false}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}
\pagestyle{plain}
\renewcommand{\frontmatter}{
    \input{frontmatter/personalize}
    \maketitle
    \copyrightpage
    \abstractpage
    \dedicationpage
    \tableofcontents
    \acknowledgments
    % \listoffigures % optional
    \setcounter{page}{1}
    \pagenumbering{arabic}
}

% Use co-advisors only when both names are supplied.
\newcommand{\berkeleyadvisors}[2]{%
    \ifboolexpr{test {\ifdefvoid{\@coadvisorOne}} or test {\ifdefvoid{\@coadvisorTwo}}}
        {#2}{#1}%
}

\renewcommand{\maketitle}{%
    \clearpage
    \thispagestyle{empty}
    \begin{center}
    \normalfont\normalsize
    \thetitle\par
    \vspace{\baselineskip}
    By\par
    \vspace{\baselineskip}
    \theauthor\par
    \vspace{2\baselineskip}
    A dissertation submitted in partial satisfaction of the\par
    \vspace{\baselineskip}
    requirements for the degree of\par
    \vspace{\baselineskip}
    \@degree\par
    \vspace{\baselineskip}
    in\par
    \vspace{\baselineskip}
    \@department\par
    \vspace{\baselineskip}
    in the\par
    \vspace{\baselineskip}
    Graduate Division\par
    \vspace{\baselineskip}
    of the\par
    \vspace{\baselineskip}
    \@university\par
    \vspace{2\baselineskip}
    Committee in charge:\par
    \vspace{\baselineskip}
    \berkeleyadvisors{%
        Professor \@coadvisorOne, Co-Chair\par
        \vspace{\baselineskip}
        Professor \@coadvisorTwo, Co-Chair\par
        \vspace{\baselineskip}
        Professor \@committeeInternal\par
    }{%
        Professor \@advisor, Chair\par
        \vspace{\baselineskip}
        Professor \@committeeInternalOne\par
        \vspace{\baselineskip}
        Professor \@committeeInternalTwo\par
    }%
    \vspace{\baselineskip}
    Professor \@committeeExternal\par
    \vspace{2\baselineskip}
    \@degreeterm\ \@degreeyear
    \end{center}
    \clearpage
}

\newcommand{\copyrightpage}{%
    \thispagestyle{empty}
    \vspace*{\fill}
    \begin{center}
    \normalfont\normalsize\copyright\ \@degreeyear\ \theauthor\par
    All rights reserved.
    \end{center}
    \vspace*{\fill}
    \clearpage
}

\newcommand{\abstractpage}{%
    \clearpage
    \pagenumbering{arabic}
    \pagestyle{plain}
    \begin{center}
    \normalfont\normalsize
    \begin{spacing}{2.0}
    Abstract\par
    \thetitle\par
    by\par
    \theauthor\par
    \@degree\ in \@department\par
    \@university\par
    \berkeleyadvisors{%
        Professor \@coadvisorOne, Co-Chair\par
        Professor \@coadvisorTwo, Co-Chair\par
    }{Professor \@advisor, Chair\par}%
    \end{spacing}
    \end{center}
    \vspace{2\baselineskip}
    \setstretch{1.0}
    \input{frontmatter/abstract}
    \clearpage
}

\newcommand{\acknowledgments}{
    \chapter*{Acknowledgments}
    \noindent
    \input{frontmatter/thanks}
    \vspace*{\fill} \newpage
}

\newcommand{\dedicationpage}{
    \clearpage
    \setcounter{page}{1}
    \pagenumbering{roman}
     \thispagestyle{fancy} \vspace*{\fill}
    \scshape \noindent \input{frontmatter/dedication}
    \vspace*{\fill} \newpage \rm
}


\renewcommand{\backmatter}{
    \input{endmatter/personalize}
    \clearpage
    \phantomsection
    \addcontentsline{toc}{chapter}{References}
    \bibliography{references}
    \bibliographystyle{apalike2}
    \begin{appendices}
        \include{chapters/appendixA}
    \end{appendices}
    \dissertatecolophon
}
