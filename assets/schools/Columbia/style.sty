% Columbia GSAS Ph.D. dissertation layout (DES is outside this template's scope).
% https://www.gsas.columbia.edu/content/formatting-guidelines-and-dissertation-template
\university{Columbia University}
\universitycity{New York}
\universitystate{New York}
\definecolor{SchoolColor}{HTML}{000000}
\definecolor{chaptergrey}{HTML}{000000}
% Reserve bottom clearance for text descenders and the page-number glyphs.
\geometry{reset,letterpaper,margin=1in,bottom=1.1in,footskip=0.2in}
\hypersetup{colorlinks,citecolor=black,filecolor=black,linkcolor=black,urlcolor=black}
\iftoggle{DissertateSingleSpace}{%
    \ClassWarning{Dissertate}{Columbia requires double-spaced text; ignoring dsingle.}%
}{}
\renewcommand{\dnormalspacing}{2.0}
\renewcommand{\dcompressedspacing}{1.0}
\renewenvironment{itemize}
    {\begin{spacing}{\dnormalspacing}\olditemize}
    {\endolditemize\end{spacing}}
\renewenvironment{enumerate}
    {\begin{spacing}{\dnormalspacing}\oldenumerate}
    {\endoldenumerate\end{spacing}}
\renewcommand{\chapnumfont}{\normalfont\normalsize}
\renewcommand*{\chapterheadstartvskip}{\vspace*{0pt}}
\fancypagestyle{plain}{%
    \fancyhf{}
    \fancyfoot[C]{\normalfont\normalsize\thepage}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{plain}
\microtypesetup{protrusion=false}
\setlength{\cftbeforechapskip}{0pt}
% Manuscript completion year may differ from the degree-conferral year.
\newcommand{\columbiacopyrightyear}[1]{\gdef\columbia@copyrightyear{#1}}
\columbiacopyrightyear{\@degreeyear}
% setspace makes each footnote single spaced; add one single-spaced line between notes.
\setlength{\footnotesep}{2\baselineskip}
\apptocmd{\@openbib@code}{\setlength{\itemsep}{\baselineskip}\setlength{\parsep}{0pt}}{}{}
\patchcmd{\thebibliography}{\chapter*{\bibname}}
    {\chapter*{\bibname}\phantomsection\addcontentsline{toc}{chapter}{\bibname}}
    {}{\ClassError{Dissertate}{Cannot link the bibliography heading}{Check the bibliography definition.}}

\renewcommand{\frontmatter}{%
    \input{frontmatter/personalize}
    \hypersetup{pageanchor=false}
    \pagestyle{empty}
    \maketitle
    \copyrightpage
    \setstretch{\dnormalspacing}
    \abstractpage
    \pagenumbering{roman}
    \hypersetup{pageanchor=true}
    \pagestyle{plain}
    \tableofcontents
    \clearpage
    \listoffigures
    \clearpage
    \listoftables
    \clearpage
    \columbiafrontsection{Acknowledgments}{frontmatter/thanks}
    \columbiafrontsection{Dedication}{frontmatter/dedication}
    \pagenumbering{arabic}
}
\renewcommand{\maketitle}{%
    \thispagestyle{empty}
    \begingroup
    \centering
    \setstretch{1}
    \vspace*{82.1pt}
    \thetitle\par
    \vspace{40.75pt}
    \theauthor\par
    \vspace{261.6pt}
    Submitted in partial fulfillment of the\par
    requirements for the degree of\par
    Doctor of Philosophy\par
    under the Executive Committee\par
    of the Graduate School of Arts and Sciences\par
    \vspace{38.15pt}
    COLUMBIA UNIVERSITY\par
    \vspace{26.95pt}
    \@degreeyear\par
    \endgroup
    \clearpage
}
\newcommand{\copyrightpage}{%
    \thispagestyle{empty}
    \begingroup
    \centering
    \setstretch{2}
    \vspace*{\fill}
    \copyright\ \columbia@copyrightyear\par
    \theauthor\par
    All Rights Reserved\par
    \vspace*{22pt}
    \endgroup
    \clearpage
}
\newcommand{\abstractpage}{%
    \pagestyle{empty}
    \begin{center}
    ABSTRACT\par
    \thetitle\par
    \theauthor\par
    \end{center}
    \vspace*{26.6pt}
    \input{frontmatter/abstract}
    \clearpage
}
\newcommand{\columbiafrontsection}[2]{%
    \begin{center}#1\end{center}
    \phantomsection
    \addcontentsline{toc}{chapter}{#1}
    \input{#2}
    \clearpage
}
\renewcommand{\backmatter}{%
    \input{endmatter/personalize}
    \clearpage
    \begingroup
    \setstretch{1}
    \bibliographystyle{apalike2}
    \bibliography{references}
    \endgroup
    \begin{appendices}
        \include{chapters/appendixA}
    \end{appendices}
}
