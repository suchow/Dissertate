#!/usr/bin/env python3
"""Stage separate local LaTeX-class and historical-font TDS components."""
import argparse
import hashlib
import json
from pathlib import Path

EXPECTED_FONTS = {
    'EB Garamond': ['EBGaramond12-Regular.otf', 'EBGaramond12-Italic.otf',
                    'EBGaramond-Bold.ttf', 'EBGaramond-BoldItalic.ttf'],
    'Lato': ['Lato-Reg.ttf', 'Lato-RegIta.ttf', 'Lato-Bol.ttf', 'Lato-BolIta.ttf'],
    'Source Code Pro': ['SourceCodePro-Regular.ttf', 'SourceCodePro-Bold.ttf'],
}
FONT_NOTICES = ['assets/fonts/EB Garamond/COPYING', 'assets/fonts/EB Garamond/OFL.txt',
                'assets/fonts/Lato/SIL Open Font License 1.1.txt',
                'assets/fonts/Source Code Pro/OFL.txt']
CD = 'doc/latex/dissertate/'
FD = 'doc/fonts/dissertate-historical-fonts/'
CS = 'source/latex/dissertate/'
FS = 'source/fonts/dissertate-historical-fonts/'


def digest(data):
    return hashlib.sha256(data).hexdigest()


def class_payload(read):
    payload = {}
    raw_base = read('assets/latex-base/Dissertate.cls')
    raw_school = read('assets/schools/Generic/style.sty')
    payload['source/latex/dissertate/inputs/dissertate-base-original.cls'] = raw_base
    payload['source/latex/dissertate/inputs/dissertate-school-generic-original.sty'] = raw_school
    base = raw_base.decode()
    school = raw_school.decode()
    if base.count('\\ProvidesClass{Dissertate}') != 1 or '\\endinput' in base:
        raise ValueError('unexpected base identity or terminator')
    if any(x in school for x in ['\\ProvidesPackage', '\\endinput', 'fonts/', '\\includegraphics']):
        raise ValueError('unexpected Generic package/resource pattern')
    options = ['a4paper', 'letterpaper', 'dpaperafour', 'dpaperletter', 'dsingle', 'ddouble']
    import re
    if re.findall(r'\\DeclareOption\{([^}]+)\}', base) != options:
        raise ValueError('unexpected base options')
    paths = {'EB Garamond': 4, 'Lato': 1, 'Source Code Pro': 1}
    for family, count in paths.items():
        pattern = 'Path={fonts/' + family + '/},'
        if base.count(pattern) != count:
            raise ValueError('unexpected font path count: ' + family)
        base = base.replace(pattern, '')
    for family, names in EXPECTED_FONTS.items():
        for name in names:
            if name not in base:
                raise ValueError('missing font declaration: ' + name)
            prefixed = 'dissertate-historical-' + name
            base = base.replace(name, prefixed)
    if 'Path=' in base or 'fonts/' in base:
        raise ValueError('untransformed font path')
    declared = set(re.findall(r'[A-Za-z0-9_-]+\.(?:otf|ttf)', base))
    if declared != {'dissertate-historical-' + n for ns in EXPECTED_FONTS.values() for n in ns}:
        raise ValueError('unexpected font filename declaration')
    runtime = 'tex/latex/dissertate/'
    base = base.replace('\\ProvidesClass{Dissertate}', '\\ProvidesClass{dissertate-base}')
    base = base.replace('\\ClassWarning{Dissertate}', '\\ClassWarning{dissertate-base}')
    notice = ('% Modified by the Dissertate staging tool, 2026-11-25.\n'
              '% Class identity renamed; font paths removed and external filenames prefixed.\n')
    payload[runtime + 'dissertate-base.cls'] = (notice + base + '\n\\endinput\n').encode()
    payload[runtime + 'dissertate.cls'] = r'''\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{dissertate}[2026/11/25 local LaTeX school-neutral candidate]
\DeclareOption{school=generic}{}
\DeclareOption{a4paper}{\PassOptionsToClass{a4paper}{dissertate-base}}
\DeclareOption{letterpaper}{\PassOptionsToClass{letterpaper}{dissertate-base}}
\DeclareOption{dpaperafour}{\PassOptionsToClass{dpaperafour}{dissertate-base}}
\DeclareOption{dpaperletter}{\PassOptionsToClass{dpaperletter}{dissertate-base}}
\DeclareOption{dsingle}{\PassOptionsToClass{dsingle}{dissertate-base}}
\DeclareOption{ddouble}{\PassOptionsToClass{ddouble}{dissertate-base}}
\DeclareOption*{\ClassError{dissertate}{Unsupported option \CurrentOption}{Only Generic is staged}}
\ProcessOptions\relax
\LoadClass{dissertate-base}
\RequirePackage{dissertate-school-generic}
\endinput
'''.encode()
    payload[runtime + 'dissertate-school-generic.sty'] = (
        '% Packaged as a separate style by the Dissertate staging tool, 2026-11-25.\n'
        '\\ProvidesPackage{dissertate-school-generic}[2026/11/25 local candidate]\n'
        + school + '\n\\endinput\n').encode()
    payload[CD + 'README.md'] = read('docs/ctan-generic/README.md')
    payload[CD + 'dissertate-doc.tex'] = read('docs/ctan-generic/dissertate-doc.tex')
    payload[CD + 'notices/LICENSE'] = read('LICENSE')
    payload[CS + 'dissertate-stage.py'] = Path(__file__).read_bytes()
    example = CD + 'examples/generic/'
    payload[example + 'main.tex'] = r"""\documentclass[school=generic,dsingle]{dissertate}
\title{Synthetic Generic example}\author{Example Author}
\department{Example Studies}\degree{Doctor of Philosophy}\field{Testing}
\degreemonth{November}\degreeyear{2026}
\togglefalse{DissertateColophonImage}
\togglefalse{DissertateColophon}
\begin{document}
\maketitle\clearpage\mainmatter
\chapter{Historical fonts}
Regular 0123456789. \textit{Italic}. \textbf{Bold}. \textbf{\textit{Bold italic}}.
{\smallcaps Small capitals}. {\sffamily Sans \textbf{bold} \textit{italic} \textbf{\textit{bold italic}}}.
{\ttfamily Mono \textbf{bold}}. $x+\alpha=123$.
\begin{figure}[h]\centering\rule{20mm}{5mm}\caption{Synthetic caption}\end{figure}
\begin{thebibliography}{1}\bibitem{demo} Example Author. Synthetic reference. 2026.\end{thebibliography}
\end{document}
""".encode()
    for name in ['abstract', 'dedication', 'thanks', 'personalize']:
        payload[example + 'frontmatter/' + name + '.tex'] = b'% Synthetic user resource.\n'
    return payload


def font_payload(read):
    payload = {}
    fonts = []
    for family, names in EXPECTED_FONTS.items():
        for name in names:
            original = 'assets/fonts/' + family + '/' + name
            data = read(original)
            kind = 'opentype' if name.endswith('.otf') else 'truetype'
            target = 'fonts/' + kind + '/public/dissertate/' + 'dissertate-historical-' + name
            payload[target] = data
            fonts.append(dict(original=original, prefixed=target, sha256=digest(data)))
    payload[FD + 'README.md'] = read('docs/ctan-fonts/README.md')
    payload[FD + 'dissertate-historical-fonts-doc.tex'] = read('docs/ctan-fonts/dissertate-historical-fonts-doc.tex')
    for original in ['LICENSE'] + FONT_NOTICES:
        flat = original.replace(' ', '-').replace('/', '--')
        payload[FD + 'notices/' + flat] = read(original)
    payload[FS + 'dissertate-historical-fonts-stage.py'] = Path(__file__).read_bytes()
    return payload, fonts


def stage(source, destination, manual_pdf=None, font_manual_pdf=None, component='all'):
    if component not in ('class', 'fonts', 'all'):
        raise ValueError('component must be class, fonts, or all')
    if component == 'class' and font_manual_pdf is not None:
        raise ValueError('class component does not accept a font manual')
    if component == 'fonts' and manual_pdf is not None:
        raise ValueError('font component does not accept a class manual')
    source = source.resolve(strict=True)
    if destination.exists() or destination.is_symlink():
        raise ValueError('destination already exists')
    destination = destination.parent.resolve(strict=True) / destination.name
    if destination == source or source in destination.parents:
        raise ValueError('destination must be outside source')
    inputs = {}
    def read(relative):
        p = source / relative
        if not p.is_file() or p.is_symlink() or source not in p.resolve().parents:
            raise ValueError('missing, symlinked, or external source: ' + relative)
        data = p.read_bytes()
        inputs[relative] = digest(data)
        return data
    payload, fonts = {}, []
    if component in ('class', 'all'):
        payload.update(class_payload(read))
    if component in ('fonts', 'all'):
        font_data, fonts = font_payload(read)
        payload.update(font_data)
    for pdf, key, target in [(manual_pdf, 'provided-manual-pdf', CD + 'dissertate-doc.pdf'),
                             (font_manual_pdf, 'provided-font-manual-pdf', FD + 'dissertate-historical-fonts-doc.pdf')]:
        if pdf is not None:
            if not pdf.is_file() or pdf.is_symlink():
                raise ValueError('manual PDF must be a regular file')
            data = pdf.read_bytes()
            if not data.startswith(b'%PDF-'):
                raise ValueError('manual PDF file header is invalid')
            inputs[key] = digest(data)
            payload[target] = data
    manifest = dict(component=component, inputs=inputs, fonts=fonts,
                    manual_pdf_included=manual_pdf is not None,
                    font_manual_pdf_included=font_manual_pdf is not None,
                    outputs={k: digest(v) for k,v in sorted(payload.items())})
    payload['candidate-manifest.json'] = (json.dumps(manifest, indent=2, sort_keys=True) + '\n').encode()
    destination.mkdir()
    for relative, data in sorted(payload.items()):
        target = destination / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open('xb') as stream:
            stream.write(data)
    return manifest


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('source_root', type=Path)
    parser.add_argument('new_output_directory', type=Path)
    parser.add_argument('--component', choices=['class', 'fonts', 'all'], default='all')
    parser.add_argument('--manual-pdf', type=Path, help='reviewed class manual PDF; never compiled by staging')
    parser.add_argument('--font-manual-pdf', type=Path, help='reviewed font manual PDF; never compiled by staging')
    args = parser.parse_args()
    try:
        stage(args.source_root, args.new_output_directory, args.manual_pdf, args.font_manual_pdf, args.component)
    except (ValueError, OSError) as exc:
        parser.exit(1, str(exc) + '\n')
