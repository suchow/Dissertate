#!/usr/bin/env python3
"""Prepare separate local class and historical-font source packages."""
import argparse
import hashlib
import json
import re
import stat
import sys
from pathlib import Path, PurePosixPath

CD = 'doc/latex/dissertate/'
FD = 'doc/fonts/dissertate-historical-fonts/'
CS = 'source/latex/dissertate/'
FS = 'source/fonts/dissertate-historical-fonts/'
FAMILIES = {
    'EB Garamond': ['EBGaramond12-Regular.otf', 'EBGaramond12-Italic.otf', 'EBGaramond-Bold.ttf', 'EBGaramond-BoldItalic.ttf'],
    'Lato': ['Lato-Reg.ttf', 'Lato-RegIta.ttf', 'Lato-Bol.ttf', 'Lato-BolIta.ttf'],
    'Source Code Pro': ['SourceCodePro-Regular.ttf', 'SourceCodePro-Bold.ttf'],
}
FONT_NOTICES = ['assets/fonts/EB Garamond/COPYING', 'assets/fonts/EB Garamond/OFL.txt',
                'assets/fonts/Lato/SIL Open Font License 1.1.txt', 'assets/fonts/Source Code Pro/OFL.txt']
PACKAGES = {'class': 'dissertate', 'fonts': 'dissertate-historical-fonts'}
README = {
'class': '''# Dissertate LaTeX class source candidate

Version: {version}

Project: https://github.com/suchow/Dissertate
Issues: https://github.com/suchow/Dissertate/issues

This package contains LaTeX class sources and documentation. It requires the separate `dissertate-historical-fonts` package for typesetting. It contains no font binaries. The internal `school=generic` option selects the school-neutral dissertation layout; this is LaTeX software, not Plain TeX software.

Project code and documentation use the GNU Affero General Public License, version 3. The dependency's fonts have separate SIL Open Font License, version 1.1, terms. See `licenses/LICENSE` and the separate font package's notices.

From this directory, run `python3 source/dissertate-prepare.py --reconstruct . /new/private/class-inputs`. The destination must not exist and its parent must exist. Reconstruction copies the finite source payload and checks written hashes against bytes read; this establishes copy consistency, not authenticity. It executes no included generator. Review the reconstructed source, then use `python3 /new/private/class-inputs/scripts/stage-ctan-generic /new/private/class-inputs /new/private/class-tds --component class --manual-pdf /new/private/class-inputs/provided-manual.pdf`.

The class component can be regenerated without reading font binaries. Typesetting requires the separate font TDS tree on the TeX search path. See `doc/dissertate-doc.pdf`, its source, and `source/dissertate-staging-readme.md` for dependencies, installation tests, and author resources. The documented fixtures were tested on TeX Live 2025/macOS. MiKTeX and complete dissertations remain unverified. Inherited Palatino-bold and mono-italic substitutions remain.

This local preparation does not submit to CTAN, publish a release, or create a tag. Existing destinations are refused. I/O failure may leave partial new output; no caller data is deleted or overwritten. Use a private parent without concurrent writers. CTAN acceptance and TeX distribution inclusion remain separate.
''',
'fonts': '''# Dissertate historical fonts source candidate

Version: {version}

Project: https://github.com/suchow/Dissertate
Issues: https://github.com/suchow/Dissertate/issues

This separate font package provides ten historical font files used by the `dissertate` LaTeX class. It contains no class or style files. External filenames have a `dissertate-historical-` prefix. Font bytes and internal names remain unchanged.

The fonts retain SIL Open Font License, version 1.1, terms, copyright notices, and embedded Reserved Font Name metadata. Notices are in `licenses/`. Preparation programs and documentation use the repository's GNU Affero General Public License, version 3; its text is in `licenses/LICENSE`. The AGPL does not replace the fonts' OFL terms.

From this directory, run `python3 source/dissertate-historical-fonts-prepare.py --reconstruct . /new/private/font-inputs`. The destination must not exist and its parent must exist. Reconstruction copies the finite source payload and verifies written hashes against bytes read; this establishes copy consistency, not authenticity. It executes no included generator. Review the reconstructed source, then use `python3 /new/private/font-inputs/scripts/stage-ctan-generic /new/private/font-inputs /new/private/font-tds --component fonts --font-manual-pdf /new/private/font-inputs/provided-font-manual.pdf`.

See `doc/dissertate-historical-fonts-doc.pdf` and its source for font inventory, license notices, and installation. These inputs reconstruct this packaging, not historical font build sources. No font is rebuilt or substituted. The documented fixtures were tested on TeX Live 2025/macOS; MiKTeX remains unverified.

This local preparation does not submit to CTAN, publish a release, or create a tag. Existing destinations are refused. I/O failure may leave partial new output; no caller data is deleted or overwritten. Use a private parent without concurrent writers. CTAN acceptance and TeX distribution inclusion remain separate.
'''}


def sha(data):
    return hashlib.sha256(data).hexdigest()


def relative(value):
    if not isinstance(value, str) or not value or '\\' in value:
        raise ValueError('invalid relative path')
    if PurePosixPath(value).is_absolute() or any(p in ('', '.', '..') for p in value.split('/')):
        raise ValueError('invalid relative path')
    return value


def new_destination(path, root):
    if path.exists() or path.is_symlink():
        raise ValueError('destination exists')
    path = path.parent.resolve(strict=True) / path.name
    if path == root or root in path.parents:
        raise ValueError('destination inside input')
    return path


def unique_json(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('duplicate JSON key')
        result[key] = value
    return result


def read_tree(root, allowed):
    data = {}
    directories = {p.as_posix() for name in allowed for p in PurePosixPath(name).parents if p.as_posix() != '.'}
    for path in root.rglob('*'):
        key = relative(path.relative_to(root).as_posix())
        mode = path.lstat().st_mode
        if stat.S_ISDIR(mode):
            if key not in directories:
                raise ValueError('unexpected directory ' + key)
        elif stat.S_ISREG(mode):
            if key not in allowed:
                raise ValueError('unexpected file ' + key)
            data[key] = path.read_bytes()
        else:
            raise ValueError('symlink or special input')
    if set(data) != set(allowed):
        raise ValueError('missing input')
    return data


def stage_mapping(component):
    if component == 'class':
        return {
            CD+'README.md': ('source/dissertate-staging-readme.md', 'docs/ctan-generic/README.md'),
            CD+'dissertate-doc.tex': ('doc/dissertate-doc.tex', 'docs/ctan-generic/dissertate-doc.tex'),
            CD+'dissertate-doc.pdf': ('doc/dissertate-doc.pdf', 'provided-manual.pdf'),
            CD+'notices/LICENSE': ('licenses/LICENSE', 'LICENSE'),
            CS+'dissertate-stage.py': ('source/dissertate-stage.py', 'scripts/stage-ctan-generic'),
            CS+'inputs/dissertate-base-original.cls': ('source/dissertate-base-original.cls', 'assets/latex-base/Dissertate.cls'),
            CS+'inputs/dissertate-school-generic-original.sty': ('source/dissertate-school-generic-original.sty', 'assets/schools/Generic/style.sty'),
        }
    mapping = {
        FD+'README.md': ('source/dissertate-historical-fonts-staging-readme.md', 'docs/ctan-fonts/README.md'),
        FD+'dissertate-historical-fonts-doc.tex': ('doc/dissertate-historical-fonts-doc.tex', 'docs/ctan-fonts/dissertate-historical-fonts-doc.tex'),
        FD+'dissertate-historical-fonts-doc.pdf': ('doc/dissertate-historical-fonts-doc.pdf', 'provided-font-manual.pdf'),
        FS+'dissertate-historical-fonts-stage.py': ('source/dissertate-historical-fonts-stage.py', 'scripts/stage-ctan-generic'),
    }
    for family, names in FAMILIES.items():
        for name in names:
            kind = 'opentype' if name.endswith('.otf') else 'truetype'
            prefixed = 'dissertate-historical-' + name
            mapping['fonts/'+kind+'/public/dissertate/'+prefixed] = ('fonts/'+prefixed, 'assets/fonts/'+family+'/'+name)
    for original in ['LICENSE'] + FONT_NOTICES:
        flat = original.replace(' ', '-').replace('/', '--')
        mapping[FD+'notices/'+flat] = ('licenses/'+flat, original)
    return mapping


def derived_class_files():
    return {'tex/latex/dissertate/'+name for name in ('dissertate.cls', 'dissertate-base.cls', 'dissertate-school-generic.sty')} | {
        CD+'examples/generic/main.tex'} | {CD+'examples/generic/frontmatter/'+name+'.tex' for name in ('abstract', 'dedication', 'thanks', 'personalize')}


def project(stage, output, version):
    if not re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', version):
        raise ValueError('strict MAJOR.MINOR.PATCH required')
    if stage.is_symlink():
        raise ValueError('symlink input root')
    root = stage.resolve(strict=True)
    output = new_destination(output, root)
    manifest_path = root/'candidate-manifest.json'
    if not manifest_path.is_file() or manifest_path.is_symlink():
        raise ValueError('missing or symlinked manifest')
    manifest = json.loads(manifest_path.read_bytes(), object_pairs_hook=unique_json)
    if set(manifest) != {'component', 'inputs', 'outputs', 'fonts', 'manual_pdf_included', 'font_manual_pdf_included'}:
        raise ValueError('unexpected manifest schema')
    component = manifest['component']
    if component not in ('class', 'fonts', 'all'):
        raise ValueError('unexpected component')
    components = ('class', 'fonts') if component == 'all' else (component,)
    mappings = {c: stage_mapping(c) for c in components}
    allowed = set().union(*(set(m) for m in mappings.values()))
    if 'class' in components:
        allowed |= derived_class_files()
    if manifest['manual_pdf_included'] is not ('class' in components) or manifest['font_manual_pdf_included'] is not ('fonts' in components):
        raise ValueError('each included component requires its reviewed PDF')
    data = read_tree(root, allowed | {'candidate-manifest.json'})
    if not isinstance(manifest['outputs'], dict) or set(manifest['outputs']) != allowed:
        raise ValueError('unexpected manifest payload')
    for key, digest in manifest['outputs'].items():
        if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest) or sha(data[key]) != digest:
            raise ValueError('payload hash mismatch')
    expected_inputs = {}
    for mapping in mappings.values():
        for key, (_, original) in mapping.items():
            if original == 'scripts/stage-ctan-generic':
                continue
            original = {'provided-manual.pdf': 'provided-manual-pdf', 'provided-font-manual.pdf': 'provided-font-manual-pdf'}.get(original, original)
            expected_inputs[original] = sha(data[key])
    if manifest['inputs'] != expected_inputs:
        raise ValueError('input hashes/paths mismatch')
    expected_fonts = []
    if 'fonts' in components:
        for family, names in FAMILIES.items():
            for name in names:
                kind = 'opentype' if name.endswith('.otf') else 'truetype'
                target = 'fonts/'+kind+'/public/dissertate/dissertate-historical-'+name
                expected_fonts.append(dict(original='assets/fonts/'+family+'/'+name, prefixed=target, sha256=sha(data[target])))
    if manifest['fonts'] != expected_fonts:
        raise ValueError('font mapping mismatch')
    packages, records = {}, {}
    for c, mapping in mappings.items():
        payload = {out: data[key] for key, (out, _) in mapping.items()}
        docname = 'dissertate-doc' if c == 'class' else 'dissertate-historical-fonts-doc'
        if not payload['doc/'+docname+'.pdf'].startswith(b'%PDF-'):
            raise ValueError('invalid PDF header')
        payload['VERSION'] = (version+'\n').encode()
        payload['README.md'] = README[c].format(version=version).encode()
        selfname = 'source/'+PACKAGES[c]+'-prepare.py'
        payload[selfname] = Path(__file__).read_bytes()
        names = [Path(p).name.casefold() for p in payload]
        if len(names) != len(set(names)):
            raise ValueError('basename collision')
        hashes = [sha(value) for value in payload.values()]
        if len(hashes) != len(set(hashes)):
            raise ValueError('duplicate blob')
        records[c] = [(out, original, sha(data[key])) for key, (out, original) in sorted(mapping.items())]
        records[c].append((selfname, 'scripts/prepare-ctan-source', sha(payload[selfname])))
        packages[c] = payload
    output.mkdir()
    for c, payload in packages.items():
        package = output/PACKAGES[c]
        package.mkdir()
        for relative, value in sorted(payload.items()):
            path = package/relative
            path.parent.mkdir(parents=True, exist_ok=True)
            with path.open('xb') as stream:
                stream.write(value)
    return records


def reconstruct(package, output):
    if package.is_symlink():
        raise ValueError('symlink package root')
    root = package.resolve(strict=True)
    output = new_destination(output, root)
    version_path = root/'VERSION'
    if not version_path.is_file() or version_path.is_symlink():
        raise ValueError('missing or symlinked version')
    version = version_path.read_bytes().decode('ascii')
    if not re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\n', version):
        raise ValueError('invalid package version')
    readme = root/'README.md'
    if not readme.is_file() or readme.is_symlink():
        raise ValueError('missing or symlinked README')
    candidates = [c for c in PACKAGES if readme.read_bytes() == README[c].format(version=version[:-1]).encode()]
    if len(candidates) != 1:
        raise ValueError('unexpected package README')
    component = candidates[0]
    mapping = {out: original for out, original in stage_mapping(component).values()}
    mapping['source/'+PACKAGES[component]+'-prepare.py'] = 'scripts/prepare-ctan-source'
    data = read_tree(root, set(mapping)|{'README.md', 'VERSION'})
    pdf = 'doc/'+('dissertate-doc' if component == 'class' else 'dissertate-historical-fonts-doc')+'.pdf'
    if not data[pdf].startswith(b'%PDF-'):
        raise ValueError('invalid PDF header')
    records = [(rel, original, sha(data[rel])) for rel, original in sorted(mapping.items())]
    output.mkdir()
    for rel, original, digest in records:
        target = output/original
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open('xb') as stream:
            stream.write(data[rel])
        if sha(target.read_bytes()) != digest:
            raise OSError('written copy hash mismatch')
    return records


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    if len(sys.argv)>1 and sys.argv[1] == '--reconstruct':
        parser.add_argument('package', type=Path)
        parser.add_argument('new_source_root', type=Path)
        args = parser.parse_args(sys.argv[2:])
        operation = lambda: reconstruct(args.package, args.new_source_root)
    else:
        parser.add_argument('staged_tree', type=Path)
        parser.add_argument('new_output', type=Path)
        parser.add_argument('version')
        args = parser.parse_args()
        operation = lambda: project(args.staged_tree, args.new_output, args.version)
    try:
        operation()
    except (ValueError, OSError, KeyError, TypeError) as exc:
        parser.exit(1, str(exc)+'\n')
