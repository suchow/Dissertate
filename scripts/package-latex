#!/usr/bin/env python3
"""Assemble one school-specific LaTeX source archive."""

import argparse
import shutil
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("school", help="school directory under assets/schools")
    parser.add_argument("output", type=Path, help="output ZIP file")
    parser.add_argument("--compile", action="store_true", help="build and include the dissertation PDF")
    args = parser.parse_args()

    schools = ROOT / "assets" / "schools"
    school = schools / args.school
    if school.parent != schools or not (school / "style.sty").is_file():
        parser.error("school must name a directory containing style.sty")
    if args.output.suffix.lower() != ".zip":
        parser.error("output must end in .zip")
    output = args.output.resolve()
    if output.exists():
        parser.error("output already exists")
    if not output.parent.is_dir():
        parser.error("output directory does not exist")

    name = f"Dissertate-{args.school}-LaTeX"
    with tempfile.TemporaryDirectory(prefix="dissertate-package-") as temp:
        package = Path(temp) / name
        shutil.copytree(ROOT / "assets" / "latex-base", package)
        shutil.copytree(ROOT / "assets" / "fonts", package / "fonts")
        shutil.copy2(ROOT / "LICENSE", package / "LICENSE")
        for item in ("guidelines.pdf", "resources"):
            source = school / item
            if source.is_dir():
                shutil.copytree(source, package / item)
            elif source.is_file():
                shutil.copy2(source, package / item)
        for source in school.glob("*.sty"):
            if source.name != "style.sty":
                shutil.copy2(source, package / source.name)
        for source in school.glob("*.tex"):
            shutil.copy2(source, package / source.name)
        shutil.copy2(school / "agent-guidance.md", package / "AGENTS.md")
        with (package / "Dissertate.cls").open("a", encoding="utf-8") as target:
            target.write("\n" + (school / "style.sty").read_text(encoding="utf-8"))
        if args.compile:
            build = Path(temp) / "compile"
            shutil.copytree(package, build)
            latex = ["xelatex", "-interaction=nonstopmode", "-halt-on-error", "dissertation.tex"]
            for command in (latex, ["bibtex", "dissertation"], latex, latex):
                subprocess.run(command, cwd=build, check=True, timeout=120)
            shutil.copy2(build / "dissertation.pdf", package / "dissertation.pdf")
        archive = shutil.make_archive(str(Path(temp) / name), "zip", temp, name)
        shutil.copyfile(archive, output)
    print(output)


if __name__ == "__main__":
    main()
